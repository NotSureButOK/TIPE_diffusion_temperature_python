Tableau[4:44,23:40]=1
Tableaub[4:44,23:40]=1

plt.close('all')
fig, ax = plt.subplots(figsize=(10, 10))

# Affichage en noir et blanc strict
im = ax.imshow(Tableau, cmap='binary', vmin=0, vmax=1, origin='lower', interpolation='nearest')
def GOL(frame):
    global Tableau, Tableaub

    for i in range(1, N - 1):
        for j in range(1, N - 1):
            voisines = (
                    Tableau[i - 1][j - 1] + Tableau[i - 1][j] + Tableau[i - 1][j + 1] +
                    Tableau[i][j - 1] + Tableau[i][j + 1] +
                    Tableau[i + 1][j - 1] + Tableau[i + 1][j] + Tableau[i + 1][j + 1]
            )

            # Règles du Jeu de la Vie
            if voisines == 3:
                Tableaub[i][j] = 1
            elif Tableau[i][j] == 1 and voisines == 2:
                Tableaub[i][j] = 1

            else:
                Tableaub[i][j] = 0
    Tableaub[0,:]=0
    Tableaub[-1,:]=0
    Tableaub[:,0]=0
    Tableaub[:,-1]=0
    # Copie de la génération
    Tableau = Tableaub.copy()

    im.set_data(Tableau)
    return [im]


ani = animation.FuncAnimation(
    fig, GOL,
    frames=1000,
    interval=10,  # Vitesse de l'animation
    blit=True,
    repeat=False
)

